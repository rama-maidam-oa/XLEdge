<UserControl x:Class="XLEdge.Views.XLEdgeCTP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:local="clr-namespace:XLEdge.Views"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="#F8F9FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- HorizontalScrollBarVisibility changed from Disabled to Auto: this report area's own
             MinWidth (600) can now legitimately exceed the real docked pane's width (see the
             MinWidth removal on the root UserControl above) without silently clipping content that
             the user has no way to reach - it scrolls into view instead. -->
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <Grid MinWidth="600" Margin="0,0,10,0" VerticalAlignment="Stretch" MinHeight="{Binding ActualHeight,
                      RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="267*"/>
                    <ColumnDefinition Width="296*"/>
                    <ColumnDefinition Width="37*"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="4,4,4,4" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ================= Header ================= -->
                    <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left side with icon and title -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="ChartColumnSolid" Style="{StaticResource LargeIcon}"/>
                                    <TextBlock Text="Orbit XLEdge Reports" Style="{StaticResource TitleHeaderTextBlock}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock x:Name="instanceText" 
                                           Text="Instance: Dev" 
                                           Margin="0,2,0,5" 
                                           FontSize="11" 
                                           Foreground="White"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"/>
                            </Grid>

                        </Grid>
                    </Border>
                    <!-- ================= Webview Browser Section ================= -->
                    <Border Grid.Row="1" Background="White" BorderThickness="1" BorderBrush="#E9ECEF" CornerRadius="6" Margin="0,0,0,15" VerticalAlignment="Stretch">
                        <wpf:WebView2 x:Name="WebCtrl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
        <!-- Toast / Busy overlay: sibling of ScrollViewer so it can cover entire pane -->
        <local:AppOverlay x:Name="AppOverlayControl" MinHeight="200" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="100"/>
    </Grid>
</UserControl>