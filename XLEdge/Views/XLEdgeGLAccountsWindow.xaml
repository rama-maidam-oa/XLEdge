<utils:DpiAwareWindow x:Class="XLEdge.Views.XLEdgeGLAccountsWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:utils="clr-namespace:XLEdge.Utilities"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowCaption="GL Accounts Segment Selection"
        IconSymbol="LayerGroupSolid"
        WindowStyle="SingleBorderWindow"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        MinHeight="300" MaxHeight="600"
        MinWidth="470" MaxWidth="600"
        ResizeMode="CanResize"
        Background="White" ShowInTaskbar="False">

    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Style for segment rows - with vertical center alignment -->
            <Style x:Key="SegmentRowStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Background" Value="#F9FAFB"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Style for segment labels - centered vertically -->
            <Style x:Key="SegmentLabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="#1F2937"/>
                <Setter Property="Width" Value="100"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
            </Style>

            <!-- Style for segment textboxes - centered vertically -->
            <Style x:Key="SegmentTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Margin" Value="5,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1F2937"/>
            </Style>

            <!-- Style for low/high headers - centered -->
            <Style x:Key="SegmentHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#4B5563"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Margin" Value="5,0,5,0"/>
            </Style>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>

    <!-- The old header/close-button chrome below has been replaced by the native WPF-UI title
         bar (WindowStyle="SingleBorderWindow" + ExtendsContentIntoTitleBar="True", see
         GlobalStyles.xaml's Title Bar Styles section); the outer manual card Border is gone too,
         since SingleBorderWindow now provides a real native frame. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=utils:DpiAwareWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=utils:DpiAwareWindow}}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="TitleCloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

            <!-- Content Section -->
            <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Padding="15" Margin="10,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Instructions -->
                    <TextBlock Grid.Row="0" Text="Enter Low and High values for each segment. Leave empty for null or no values." 
                               FontSize="12" Foreground="#6B7280" Margin="0,0,0,15" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <!-- Scrollable segment list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Headers - with VerticalAlignment="Center" -->
                            <Border Grid.Row="0" Style="{StaticResource SegmentRowStyle}" Background="#E5E7EB">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Segment Name" 
                                               Style="{StaticResource SegmentHeaderStyle}" 
                                               HorizontalAlignment="Left" Width="Auto" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Low" Style="{StaticResource SegmentHeaderStyle}"
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="High" Style="{StaticResource SegmentHeaderStyle}"
                                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Dynamic segment rows - with proper alignment -->
                            <ItemsControl Grid.Row="1" x:Name="SegmentItemsControl" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SegmentRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding SegmentName}" 
                                                           Style="{StaticResource SegmentLabelStyle}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Low, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource SegmentTextBoxStyle}"
                                                         VerticalContentAlignment="Center"
                                                         Tag="{Binding SegmentName}"/>
                                                <TextBox Grid.Column="2" Text="{Binding High, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource SegmentTextBoxStyle}"
                                                         VerticalContentAlignment="Center"
                                                         Tag="{Binding SegmentName}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Buttons Section -->
            <Border Grid.Row="2" Style="{StaticResource CompactBorderStyle}" Padding="10,4" Margin="10,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOk" Style="{StaticResource DynamicContentButton}"
                            Content="Insert" Click="BtnOk_Click" Margin="0,0,10,0" MinWidth="80"/>
                    <Button x:Name="BtnCancel" Style="{StaticResource CloseButtonStyle}"
                            Content="Cancel" Click="BtnClose_Click" MinWidth="80"/>
                </StackPanel>
            </Border>
    </Grid>
</utils:DpiAwareWindow>