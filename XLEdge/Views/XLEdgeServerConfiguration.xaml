<utils:DpiAwareWindow x:Class="XLEdge.Views.XLEdgeServerConfiguration" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:utils="clr-namespace:XLEdge.Utilities"
                      xmlns:conv="clr-namespace:XLEdge.Converters"
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
					  xmlns:local="clr-namespace:XLEdge.Views" WindowStyle="None" WindowStartupLocation="CenterScreen"
					  SizeToContent="Manual" MinWidth="850" MaxWidth="900" MinHeight="500" MaxHeight="650" ResizeMode="CanResize"
					  Background="White" ShowInTaskbar="False"
                      Loaded="XLEdgeServerConfiguration_Loaded">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ModernDataGridText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#212529"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="EditableDataGridText" TargetType="TextBox">
                <Setter Property="Foreground" Value="#212529"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <!-- Converter to hide checkbox on new item placeholder rows -->
            <conv:HasDataAndIsNotNewItemConverter x:Key="HasDataAndIsNotNewItemConverter"/>
            <!-- DataGrid Selection Highlight Colors (window-specific) -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E6F3FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0F8FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Header ================= -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="DatabaseSolid" Style="{StaticResource LargeIcon}"/>
                        <TextBlock Text="Server Configuration" Style="{StaticResource TitleHeaderTextBlock}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- ================= Data Grid Section ================= -->
            <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,4" Background="White">
                <DataGrid x:Name="dgInstances" Background="White"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          HeadersVisibility="Column"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BeginningEdit="DgInstances_BeginningEdit"
                          CellEditEnding="DgInstances_CellEditEnding"
                          InitializingNewItem="DgInstances_InitializingNewItem"
                          SelectionChanged="DgInstances_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#149FDB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#1B6B93"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="border" Value="#389BC7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" TargetName="border" Value="#277596"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 5 0 L 10 4 Z"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 5 4 L 10 0 Z"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F8F9FA"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#212529"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="MinHeight" Value="36"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F8FF"/>
                                    <Setter Property="BorderBrush" Value="#149FDB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6F3FF"/>
                                    <Setter Property="BorderBrush" Value="#149FDB"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instance Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Friendly name for the server instance" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Naming tips:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                                <TextBlock Text="• Use descriptive names" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Example: 'Production Server'" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Avoid special characters" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <TextBlock Text="Enter a friendly name for this server instance" TextWrapping="Wrap"/>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="URL Address" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Server connection URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Address}" TextWrapping="Wrap"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Format examples:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                                <TextBlock Text="• http://server.domain.com:port/reporting" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• http://localhost:8080/reporting" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Include protocol (http/https)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Enter the complete server URL address" TextWrapping="Wrap"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Required format:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                                <TextBlock Text="• Protocol (http:// or https://)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Server name or IP address" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Port number (if not default)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Example: https://api.example.com:8443" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <!-- Default Column with CheckBox -->
                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.8*">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Visibility">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource HasDataAndIsNotNewItemConverter}">
                                                <Binding Path="HasAnyData"/>
                                                <Binding Path="IsNewItem" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Set as default server instance" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Only one server can be set as default at a time." TextWrapping="Wrap"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="✓ Check this box to make this the default server" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Visibility">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource HasDataAndIsNotNewItemConverter}">
                                                <Binding Path="HasAnyData"/>
                                                <Binding Path="IsNewItem" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ================= Action Buttons Section ================= -->
            <Border Grid.Row="2" Style="{StaticResource CompactBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StatusBorder" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,24,0" Padding="0">
                        <TextBlock x:Name="txtStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnGo" Content="GO >>" Style="{StaticResource DynamicContentButton}" Click="BtnGo_Click" Margin="0,0,8,0">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Connect to selected server" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button x:Name="btnSetDefault" Content="Set as Default" Style="{StaticResource DynamicContentButton}" Click="BtnSetDefault_Click" Margin="0,0,8,0">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Set selected server as default" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button x:Name="btnSave" Content="Save" Style="{StaticResource DynamicContentButton}" Click="BtnSave_Click" Margin="0,0,8,0">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Save configuration" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource DynamicContentButton}" Click="BtnDelete_Click" Margin="0,0,8,0">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Delete selected server configuration" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button x:Name="btnClose" Content="Close" Style="{StaticResource DynamicContentButton}" Click="BtnClose_Click" Margin="0,0,0,0">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Close the configuration window" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
        </Grid>
    </Border>
</utils:DpiAwareWindow>