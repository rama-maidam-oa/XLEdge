<utils:DpiAwareWindow x:Class="XLEdge.Views.XLEdgeMessageWindow" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                      xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
                      xmlns:utils="clr-namespace:XLEdge.Utilities" 
                      WindowStartupLocation="CenterScreen"
                      ResizeMode="CanResize"
                      SizeToContent="Manual"
                      Width="340" Height="200"
                      MinHeight="160" MaxHeight="600"
                      MinWidth="280" MaxWidth="450"
                      WindowStyle="None" Background="White"
                      ShowInTaskbar="False" Topmost="False" ShowActivated="True"
                      DisableAutoSizing="True">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Make scrollbar clearly visible (window-specific override) -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Background" Value="#E0E0E0"/>
            </Style>
            <Style TargetType="Thumb">
                <Setter Property="Background" Value="#9E9E9E"/>
                <Setter Property="BorderBrush" Value="#757575"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <!-- Bug fix ("all windows: card style not looking good, make it simple like GLSense" +
         "message window is not showing completely"): this used to be a floating card - the window
         itself was AllowsTransparency="True"/Background="Transparent", with an outer Border adding a
         14px transparent bleed margin, a DropShadowEffect, and a CornerRadius="10" rounded card
         underneath - a look GLSense's own message window (GLMessageWindow.xaml, a native-chrome
         BaseWindow with a plain, flat, square-cornered content area) does not use at all. Simplified
         to a plain, flat, opaque window (Background="White" on the Window itself, no
         AllowsTransparency) with a single thin flat border and no rounded corners/shadow - the
         closest match to GLSense's own look achievable while keeping this codebase's established
         WindowStyle="None" + custom-drawn title bar pattern (this class's own DpiAwareWindow.cs
         explicitly disables FluentWindow's native "ExtendsContentIntoTitleBar" chrome for every
         window here, so GLSense's exact native-chrome mechanism isn't available - see that file's
         own comments). Separately, the actual root cause of "not showing completely": this window's
         own XLEdgeMessageWindow_AutoFitOnce (below) already implements its own complete, purpose-built
         sizing pass (temporarily SizeToContent="WidthAndHeight" to measure, then locks back to
         "Manual" with the clamped result) - but DpiAwareWindow's OWN auto-sizing machinery
         (CaptureInitialWindowConstraints/FitToAvailableWorkArea's LayoutTransform-based scale-to-fit,
         plus its own MaxWidth/MaxHeight overrides) was also still running afterward and fighting it,
         since DisableAutoSizing was never set here even though DpiAwareWindow.cs's own doc comment
         says "Use this for message boxes and dialogs that should respect user resizing." Added
         DisableAutoSizing="True" above so this window's own AutoFitOnce sizing is the only sizing
         logic that ever runs, with nothing to override its result afterward. -->
    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <!-- Header -->
            <DockPanel x:Name="HeaderPanel" DockPanel.Dock="Top" Background="#149FDB" Height="40" LastChildFill="True" MouseLeftButtonDown="HeaderPanel_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left side with icon and title -->
                    <StackPanel Grid.Column="0" 
           Orientation="Horizontal" 
           VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="MessageSolid" 
                 Style="{StaticResource MediumIcon}" Margin="6,4,0,0" />
                        <TextBlock Text="Orbit XLEdge" 
                 Style="{StaticResource TitleHeaderTextBlock}"/>
                    </StackPanel>

                    <Button Grid.Column="2" 
             Style="{StaticResource CustomWindowCloseButtonStyle}" 
             Click="BtnClose_Click" Margin="0,0,10,0"/>
                </Grid>
            </DockPanel>
            <!-- Content -->
            <Grid Margin="15" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Message Area -->
                <!-- Bug fix history: an earlier attempt at "text moving apart on resize" made this
                     column Auto + HorizontalAlignment="Left", which stopped the text from reflowing
                     at all - directly contradicting the follow-up request that content SHOULD reflow
                     when the window is resized. The actual root cause of both symptoms was the window
                     itself: SizeToContent="WidthAndHeight" combined with ResizeMode="CanResize" fights
                     itself mid-drag (WPF keeps re-measuring the window down to its content size while
                     the user is actively dragging it bigger), which is what produced the erratic
                     "text moving apart" glitch. Fixed at the window level instead (see
                     SizeToContent="Manual" + explicit Width/Height above, with a one-time auto-fit-to-
                     content pass in the code-behind constructor) - once the window's size is a normal,
                     stable Manual value, this text column can safely go back to a genuine "*" stretch
                     column so it actually reflows/rewraps to fill whatever width the user drags to,
                     instead of needing to be artificially pinned. -->
                <!-- Bug fix ("Message window should show the bottom close/OK button at all times -
                     earlier it got trimmed"): this row and the button row below it were both plain Auto
                     rows with no scroll container, so a long message's wrapped text height could push
                     the total content (header + message + buttons) past this window's MaxHeight="600"
                     clamp. Grid gives Auto rows no protection from that clamp - once the window's overall
                     Height is capped, whichever content sits lowest (the button row) can render below
                     the window's actual bottom edge, i.e. visually trimmed, exactly as reported.
                     Deliberately did NOT switch this row to Height="*" to absorb the overflow - a bare
                     "*" row collapses toward 0 during SizeToContent's infinite-available-height
                     measurement pass (the same documented WPF gotcha behind XLEdgeWaitWindow's own
                     content row staying "Auto" - see that file's comments), which would undersize the
                     auto-fit-once pass in XLEdgeMessageWindow.xaml.cs instead of fixing anything. Instead,
                     wrapped the message in a ScrollViewer with its own explicit MaxHeight="380" - a
                     control's own MaxHeight is a real clamp on its measured DesiredSize regardless of
                     available space, so it shrinks correctly even under SizeToContent's infinite-height
                     pass, unlike a "*" row. With this cap, the message area scrolls internally once its
                     content exceeds 380px instead of growing without bound, leaving the button row (still
                     a plain Auto row, always given its full natural height by Grid's row-sizing
                     algorithm) permanently inside this window's 600px MaxHeight budget. -->
                <ScrollViewer Grid.Row="0" Margin="0,0,0,15" MaxHeight="380"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon -->
                        <iconPacks:PackIconFontAwesome x:Name="MsgIcon" Grid.Column="0" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <!-- Message Text -->
                        <TextBlock x:Name="MsgText" Grid.Column="1" TextWrapping="Wrap" FontSize="15" LineHeight="22" Foreground="#212529" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>
                <!-- Buttons -->
                <Grid Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ButtonPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</utils:DpiAwareWindow>