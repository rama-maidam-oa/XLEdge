<UserControl x:Class="XLEdge.Views.XLEdgeCTP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:local="clr-namespace:XLEdge.Views"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinHeight="400" 
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch"
             Background="#F8F9FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="True">
            <Grid MinWidth="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" 
                        BorderThickness="1" 
                        BorderBrush="#E9ECEF" 
                        CornerRadius="6" 
                        Margin="4">
                    <wpf:WebView2 x:Name="WebCtrl" 
                                  HorizontalAlignment="Stretch" 
                                  VerticalAlignment="Stretch"
                                  MinHeight="400"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch" 
                          Visibility="Collapsed" 
                          Panel.ZIndex="100"/>
    </Grid>
</UserControl>