<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
					xmlns:views="clr-namespace:XLEdge.Views" >

    <!-- ==================== Color Resources (orbit application color #149fdb ==================== -->
    <Color x:Key="PrimaryColor">#149FDB</Color>
    <Color x:Key="PrimaryDarkColor">#108CB1</Color>
    <Color x:Key="PrimaryDarkerColor">#0D7591</Color>
    <Color x:Key="SecondaryColor">#6C757D</Color>
	<Color x:Key="SecondaryDarkColor">#5A6268</Color>
	<Color x:Key="SecondaryDarkerColor">#495057</Color>
	<Color x:Key="DangerColor">#EC616E</Color>
	<Color x:Key="DangerDarkColor">#E62E40</Color>
	<Color x:Key="DangerDarkerColor">#D02B3B</Color>
	<Color x:Key="SuccessColor">#28A745</Color>
	<Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="InfoColor">#32ABD9</Color>
    <Color x:Key="TextPrimaryColor">#212529</Color>
	<Color x:Key="TextSecondaryColor">#6C757D</Color>
	<Color x:Key="BackgroundColor">#F8F9FA</Color>
	<Color x:Key="BorderColor">#DEE2E6</Color>
	<Color x:Key="BorderLightColor">#E9ECEF</Color>
	<Color x:Key="TooltipBackgroundColor">#FFF9DB</Color>
	<Color x:Key="TooltipBorderColor">#FBB41A</Color>

	<!-- ==================== Brush Resources ==================== -->
	<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
	<SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
	<SolidColorBrush x:Key="PrimaryDarkerBrush" Color="{StaticResource PrimaryDarkerColor}"/>
	<SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
	<SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}"/>
	<SolidColorBrush x:Key="SecondaryDarkerBrush" Color="{StaticResource SecondaryDarkerColor}"/>
	<SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
	<SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}"/>
	<SolidColorBrush x:Key="DangerDarkerBrush" Color="{StaticResource DangerDarkerColor}"/>
	<SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
	<SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
	<SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
	<SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
	<SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
	<SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
	<SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
	<SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
	<SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{StaticResource TooltipBackgroundColor}"/>
	<SolidColorBrush x:Key="TooltipBorderBrush" Color="{StaticResource TooltipBorderColor}"/>

	<!-- ==================== Warning ToolTip Styles ==================== -->
	<!-- Warning ToolTip (red background) -->
	<Style x:Key="WarningToolTipStyle" TargetType="ToolTip">
		<Setter Property="Background" Value="#FFF0F0"/>
		<Setter Property="Foreground" Value="#DC3545"/>
		<Setter Property="BorderBrush" Value="#DC3545"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="8,4"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="HasDropShadow" Value="True"/>
		<Setter Property="Placement" Value="Bottom"/>
		<Style.Triggers>
			<Trigger Property="Placement" Value="Bottom">
				<Setter Property="VerticalOffset" Value="5"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- Validation Error Template (optional visual indicator) -->
	<Style x:Key="ValidationErrorStyle" TargetType="Control">
		<Setter Property="Validation.ErrorTemplate">
			<Setter.Value>
				<ControlTemplate>
					<DockPanel LastChildFill="True">
						<Border BorderBrush="#DC3545"
                            BorderThickness="1"
                            CornerRadius="4"
                            DockPanel.Dock="Top">
							<AdornedElementPlaceholder/>
						</Border>
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ==================== ToolTip Styles ==================== -->
	<!-- Simple Browser ToolTip (yellow background) -->
	<Style x:Key="SimpleBrowserToolTip" TargetType="ToolTip">
		<Setter Property="Background" Value="{StaticResource TooltipBackgroundBrush}"/>
		<Setter Property="Foreground" Value="#3C3C3C"/>
		<Setter Property="BorderBrush" Value="{StaticResource TooltipBorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="10,8"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="HasDropShadow" Value="True"/>
	</Style>

	<!-- Chrome-style ToolTip WITH Header -->
	<Style x:Key="ChromeStyleToolTip" TargetType="ToolTip">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="HasDropShadow" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToolTip">
					<Border Background="{StaticResource TooltipBackgroundBrush}"
                            BorderBrush="{StaticResource TooltipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MaxWidth="400">
						<Border.Effect>
							<DropShadowEffect Color="Black"
                                              Opacity="0.15"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Direction="315"/>
						</Border.Effect>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<!-- Chrome-style Tip Header -->
							<Border Grid.Row="0"
                                    Background="{StaticResource TooltipBorderBrush}"
                                    CornerRadius="4,4,0,0"
                                    Padding="10,6">
								<StackPanel Orientation="Horizontal">
									<iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                                    Width="12"
                                                                    Height="12"
                                                                    Foreground="Black"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"/>
									<TextBlock Text="TIP"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="Black"
                                               VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
							<!-- Content Area -->
							<Border Grid.Row="1" Padding="12,10">
								<ContentPresenter ContentSource="Content"/>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ==================== ToolTipService Default Timing ==================== -->
	<!-- Base style for all FrameworkElements to set consistent ToolTip timing -->
	<Style TargetType="FrameworkElement">
		<Setter Property="ToolTipService.InitialShowDelay" Value="50"/>
		<Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
		<Setter Property="ToolTipService.ShowDuration" Value="8000"/>
		<Setter Property="ToolTipService.Placement" Value="Mouse"/>
		<Setter Property="ToolTipService.HorizontalOffset" Value="10"/>
		<Setter Property="ToolTipService.VerticalOffset" Value="10"/>
	</Style>

	<!-- ==================== TextBox Styles ==================== -->
	<!-- Modern TextBox Style - FIXED vertical alignment issue -->
	<Style x:Key="ModernTextBox" TargetType="TextBox">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
						<ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Padding="{TemplateBinding Padding}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="border" Property="Opacity" Value="0.56"/>
							<Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
						</Trigger>
						<Trigger Property="IsFocused" Value="True">
							<Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
							<Setter TargetName="border" Property="BorderThickness" Value="2"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Read-Only TextBox Style -->
	<Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
		<Setter Property="IsReadOnly" Value="True"/>
		<Setter Property="Background" Value="#F5F5F5"/>
	</Style>



	<!-- ==================== Button Styles ==================== -->
	<!-- Base style for dynamic, content-driven buttons -->
	<Style x:Key="DynamicContentButton" TargetType="Button">
		<Setter Property="Background" Value="#F8F9FA"/>
		<Setter Property="Foreground" Value="Black"/>
		<Setter Property="BorderBrush" Value="#D0D4D8"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="MinWidth" Value="80"/>
		<Setter Property="MinHeight" Value="32"/>
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Padding" Value="16,8"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="4">
						<ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
					</Border>

					<ControlTemplate.Triggers>
						<!-- Hover -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
							<Setter TargetName="border" Property="BorderBrush" Value="#256D8F"/>
							<Setter Property="Foreground" Value="White"/>
						</Trigger>

						<!-- Pressed -->
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="border" Property="Background" Value="#256D8F"/>
							<Setter TargetName="border" Property="BorderBrush" Value="#1E5775"/>
							<!-- darker version of hover -->
						</Trigger>

						<!-- Disabled -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="border" Property="Background" Value="#D3D8DC"/>
							<Setter TargetName="border" Property="BorderBrush" Value="#B0B6BC"/>
							<Setter Property="Foreground" Value="#6C757D"/>
							<Setter Property="Opacity" Value="0.75"/>
							<Setter Property="Cursor" Value="Arrow"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Close Button Style (inherits from DynamicContentButton) -->
	<Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
		<!-- Close button specific properties -->
		<Setter Property="Content" Value="Close"/>
		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<TextBlock Text="Click to close this window!"/>
				</ToolTip>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Cancel Button Style (inherits from DynamicContentButton) -->
	<Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
		<!-- Cancel button specific properties -->
		<Setter Property="Content" Value="Cancel"/>
		<Setter Property="MaxWidth" Value="100"/>
		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<TextBlock Text="Click to cancel process!"/>
				</ToolTip>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Cancel Button Style (inherits from DynamicContentButton) -->
	<Style x:Key="InsertButtonStyle" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
		<!-- Cancel button specific properties -->
		<Setter Property="Content" Value="Insert"/>
		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<TextBlock Text="Inserts formula or values to the selected cell reference!" TextWrapping="Wrap"/>
				</ToolTip>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- Modern Primary Button Style -->
	<Style x:Key="ModernButton" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="MinWidth" Value="30"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Padding" Value="16,6"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="border"
                         Background="{TemplateBinding Background}"
                         CornerRadius="4"
                         BorderThickness="0"
                         Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkerBrush}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="border" Property="Opacity" Value="0.5"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- Add item from left data grid to right data grid Button Style (inherits from DynamicContentButton) -->
	<Style x:Key="AddToRightButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
		<Setter Property="Margin" Value="0,0,0,8"/>
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Width" Value="Auto"/>
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<iconPacks:PackIconFontAwesome Kind="RightLongSolid"
                      Width="20" Height="20" FontWeight="Normal" VerticalAlignment="Center"/>
				</DataTemplate>
			</Setter.Value>
		</Setter>

		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<StackPanel>
						<TextBlock Text="Adds the selected items to right grid"
                               TextWrapping="Wrap"/>
						<Border Background="#FBB41A"
                            CornerRadius="3"
                            Padding="8,6"
                            Margin="0,8,0,0">
							<StackPanel Orientation="Horizontal">
								<iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                           Width="12"
                                                           Height="12"
                                                           Foreground="Black"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"/>
								<TextBlock Text="Select all in a page by pressing Ctrl+A"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="Black"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ToolTip>
			</Setter.Value>
		</Setter>

		<!-- Slightly larger min size since it's icon-only -->
		<Setter Property="MinWidth"  Value="44"/>
		<Setter Property="MinHeight" Value="36"/>
		<Setter Property="Padding"   Value="10,6"/>
	</Style>
	<!-- Remove items from right data grid Button Style (inherits from ModernButton) -->
	<Style x:Key="RemoveFromRightGridButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
		<Setter Property="Margin" Value="0,0,0,8"/>
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Width" Value="Auto"/>
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<iconPacks:PackIconFontAwesome Kind="LeftLongSolid"
                  Width="20" Height="20" FontWeight="Normal" VerticalAlignment="Center"/>
				</DataTemplate>
			</Setter.Value>
		</Setter>

		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<StackPanel>
						<TextBlock Text="Removes the selected items from right grid"
                           TextWrapping="Wrap"/>
						<Border Background="#FBB41A"
                        CornerRadius="3"
                        Padding="8,6"
                        Margin="0,8,0,0">
							<StackPanel Orientation="Horizontal">
								<iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="Black"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
								<TextBlock Text="Select all in a page by pressing Ctrl+A"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="Black"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ToolTip>
			</Setter.Value>
		</Setter>

		<!-- Slightly larger min size since it's icon-only -->
		<Setter Property="MinWidth"  Value="44"/>
		<Setter Property="MinHeight" Value="36"/>
		<Setter Property="Padding"   Value="10,6"/>
	</Style>
	<!-- Select first and last seleted items from data grid Button Style (inherits from ModernButton) -->
	<Style x:Key="BetweenGridButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
		<Setter Property="Margin" Value="0,0,0,8"/>
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Width" Value="Auto"/>
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<iconPacks:PackIconFontAwesome Kind="RightLeftSolid"
                           Width="20" Height="20" FontWeight="Normal" VerticalAlignment="Center"/>
				</DataTemplate>
			</Setter.Value>
		</Setter>

		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<StackPanel>
						<TextBlock Text="Adds first and last items from selection as a range to right grid"
                       TextWrapping="Wrap"/>
						<Border Background="#FBB41A"
                    CornerRadius="3"
                    Padding="8,6"
                    Margin="0,8,0,0">
							<StackPanel Orientation="Horizontal">
								<iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                   Width="12"
                                                   Height="12"
                                                   Foreground="Black"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
								<TextBlock Text="Select any 2 items holding Ctrl key or select a range with holding Shift key"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="Black"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ToolTip>
			</Setter.Value>
		</Setter>

		<!-- Slightly larger min size since it's icon-only -->
		<Setter Property="MinWidth"  Value="44"/>
		<Setter Property="MinHeight" Value="36"/>
		<Setter Property="Padding"   Value="10,6"/>
	</Style>
	<!-- Select first and last seleted items from data grid as Not Between Button Style (inherits from ModernButton) -->
	<Style x:Key="NotBetweenGridButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
		<Setter Property="Margin" Value="0,0,0,8"/>
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Width" Value="Auto"/>
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<Grid Width="22" Height="22">
						<!-- Main arrow icon (background layer) -->
						<iconPacks:PackIconFontAwesome Kind="RightLeftSolid"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>

						<!-- Ban overlay (smaller, red, slightly offset or centered) -->
						<iconPacks:PackIconFontAwesome Kind="BanSolid"
                                                   Width="16"
                                                   Height="16"
                                                   Foreground="Red"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.85"/>
						<!-- optional: slight transparency for better look -->
					</Grid>
				</DataTemplate>
			</Setter.Value>
		</Setter>

		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<StackPanel>
						<TextBlock Text="Adds range from selected items, but excludes them from calculations"
                       TextWrapping="Wrap"/>
						<Border Background="#FBB41A"
                    CornerRadius="3"
                    Padding="8,6"
                    Margin="0,8,0,0">
							<StackPanel Orientation="Horizontal">
								<iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                   Width="12"
                                                   Height="12"
                                                   Foreground="Black"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
								<TextBlock Text="Select any 2 items holding Ctrl key or select a range with holding Shift key"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="Black"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ToolTip>
			</Setter.Value>
		</Setter>

		<!-- Slightly larger min size since it's icon-only -->
		<Setter Property="MinWidth"  Value="44"/>
		<Setter Property="MinHeight" Value="36"/>
		<Setter Property="Padding"   Value="10,6"/>
	</Style>
	<!-- Select items from data grid as Exclude from calculation Button Style (inherits from ModernButton) -->
	<Style x:Key="ExcludeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
		<Setter Property="Margin" Value="0,0,0,8"/>
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Width" Value="Auto"/>
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<iconPacks:PackIconFontAwesome Kind="BanSolid"
                             Width="20" Height="20" FontWeight="Normal" VerticalAlignment="Center"/>
				</DataTemplate>
			</Setter.Value>
		</Setter>

		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<StackPanel>
						<TextBlock Text="Adds selected items as exclusions from calculations"
                       TextWrapping="Wrap"/>
						<Border Background="#FBB41A"
                    CornerRadius="3"
                    Padding="8,6"
                    Margin="0,8,0,0">
							<StackPanel Orientation="Horizontal">
								<iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                   Width="12"
                                                   Height="12"
                                                   Foreground="Black"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
								<TextBlock Text="Select all in a page by pressing Ctrl+A"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="Black"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ToolTip>
			</Setter.Value>
		</Setter>

		<!-- Slightly larger min size since it's icon-only -->
		<Setter Property="MinWidth"  Value="44"/>
		<Setter Property="MinHeight" Value="36"/>
		<Setter Property="Padding"   Value="10,6"/>
	</Style>
	<!-- === Pagination Button Style (inherits from ModernButton) === -->
	<!-- First Page Button Style -->
	<Style x:Key="FirstPageButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
		<Setter Property="Margin" Value="2,0"/>
		<Setter Property="MinWidth" Value="18"/>
		<Setter Property="Padding" Value="10,6"/>
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<iconPacks:PackIconFontAwesome Kind="BackwardStepSolid"
                            Width="12" Height="12" FontWeight="Normal" VerticalAlignment="Center"/>
				</DataTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ToolTip">
			<Setter.Value>
				<ToolTip Style="{StaticResource SimpleBrowserToolTip}">
					<TextBlock Text="Go to first page"/>
				</ToolTip>
			</Setter.Value>
		</Setter>
