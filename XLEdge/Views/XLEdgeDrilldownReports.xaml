<utils:DpiAwareWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:utils="clr-namespace:XLEdge.Utilities" 
                      xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
                      x:Class="XLEdge.Views.XLEdgeDrilldownReports" 
                      mc:Ignorable="d"
                      WindowCaption="Drill Down Reports"
                      IconSymbol="CircleInfoSolid"
                      WindowStyle="SingleBorderWindow" ExtendsContentIntoTitleBar="True"
                      WindowStartupLocation="Manual"
                      ResizeMode="CanResize" SizeToContent="Manual"
                      MinWidth="300" MinHeight="230" MaxWidth="700" MaxHeight="700"
                      Background="White" ShowInTaskbar="False"
                      DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>

    <!-- Bug fix ("all windows: card style not looking good, make it simple like GLSense"): dropped
         the floating-card treatment (transparent window + bleed margin + DropShadowEffect + rounded
         inner card) in favor of a plain, flat, opaque, square-cornered window - see XLEdgeOptions.xaml
         for the full rationale comment. The old header/close-button chrome below has since been
         replaced by the native WPF-UI title bar (WindowStyle="SingleBorderWindow" +
         ExtendsContentIntoTitleBar="True", see GlobalStyles.xaml's Title Bar Styles section); the
         outer manual card Border is gone too, since SingleBorderWindow provides a real native frame. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=utils:DpiAwareWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=utils:DpiAwareWindow}}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="TitleCloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="CmdClose_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="10,2,10,10" Padding="0" VerticalAlignment="Stretch">
            <ListBox x:Name="DrillListCtrl"
                     ItemsSource="{Binding Reports}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingStackPanel.IsVirtualizing="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CompactBorderStyle}" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Text="Select a report to drill down into."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CmdExecute" Content="OK" Style="{StaticResource DynamicContentButton}" Click="CmdExecute_Click" Margin="8,0,8,0" MinWidth="90"/>
                    <Button x:Name="CmdClose" Content="Cancel" Style="{StaticResource DynamicContentButton}" Click="CmdClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</utils:DpiAwareWindow>
