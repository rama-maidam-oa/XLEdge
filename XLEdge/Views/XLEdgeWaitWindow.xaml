<utils:DpiAwareWindow x:Class="XLEdge.Views.XLEdgeWaitWindow" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:utils="clr-namespace:XLEdge.Utilities" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  xmlns:local="clr-namespace:XLEdge.Views" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
					  SizeToContent="Height" Width="420" MinHeight="170" MaxHeight="350" WindowStyle="None"
					  Background="White" ShowInTaskbar="False">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <!-- Bug fix ("all windows: card style not looking good, make it simple like GLSense"): this used
         to be a floating card - AllowsTransparency="True"/Background="Transparent" on the window
         itself, a 16px transparent bleed margin, a DropShadowEffect, and CornerRadius="10" rounded
         corners throughout. GLSense's own wait window is a plain, flat, square-cornered, opaque
         window (native chrome + a flat colored title bar, no rounded card/shadow illusion at all) -
         simplified to match: window is now a plain opaque Background="White" (no AllowsTransparency),
         with a single flat 1px border and square corners (no CornerRadius) throughout. -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Content - deliberately Auto, not "*": with SizeToContent="Height" WPF
                         measures this row with infinite available height, and a bare "*" row
                         collapses toward 0 in that pass instead of sizing to its content
                         (the same SizeToContent/"*" row interaction documented at length for
                         the sibling GLSense project's own wait-window sizing saga). Auto sizes
                         correctly to the actual content in every measurement pass. -->
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left side with icon and title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome x:Name="titleIcon" Kind="RotateSolid" Style="{StaticResource LargeIcon}"/>
                            <TextBlock x:Name="titleText" Text="Refreshing Data" Style="{StaticResource TitleHeaderTextBlock}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Content -->
                <!-- Bug fix (WaitWindow "not looking great" - large dead vertical gap above/below the
                     progress bar): this used to wrap the progress bar in a ScrollViewer around a Grid
                     with a Height="*" row plus two fixed 16/20px "spacing" rows, sitting inside an outer
                     "*"-sized content row on a window with no explicit Height set (only Min/MaxHeight).
                     A ScrollViewer around a single non-scrollable ProgressBar serves no purpose, and the
                     "*" rows simply stretched to fill whatever arbitrary height the window ended up at,
                     pushing the progress bar to float in the middle of a mostly-empty box. Replaced with
                     plain Auto rows + explicit margins (so the window's height is driven entirely by its
                     actual content, no leftover elastic space), and switched the window itself from
                     SizeToContent="Manual" (with no Height ever set, so WPF/Excel-hosting picked an
                     arbitrary height) to SizeToContent="Height" (Width stays fixed at 420) so the window
                     always sizes exactly to fit this simplified content, growing only if a genuinely long
                     process message wraps to a second line. -->
                <Border Grid.Row="1" Padding="20,18,20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Process Label -->
                            <RowDefinition Height="Auto"/>
                            <!-- Progress Bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Time & Button -->
                        </Grid.RowDefinitions>
                        <!-- Process Name -->
                        <TextBlock x:Name="processLabelName" FontFamily="Segoe UI" Grid.Row="0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Text="Loading data..." HorizontalAlignment="Left" Margin="0,0,0,18"/>
                        <!-- Progress Bar -->
                        <ProgressBar x:Name="ProgressBarControl" Grid.Row="1" Style="{StaticResource ModernProgressBar}" IsIndeterminate="True" Visibility="Visible" Margin="0,0,0,18"/>
                        <!-- Bottom Row: Time and Cancel Button -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Elapsed Time -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Using Clock icon for elapsed time -->
                                <iconPacks:PackIconFontAwesome Kind="ClockSolid" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ElapsedTimeLabel" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="Time Elapsed: 00:00"/>
                            </StackPanel>
                            <!-- Cancel Button -->
                            <!-- Bug fix: the icon/text below used to hardcode Foreground="White",
                                 which overrides/ignores the ProgressButton style's own Foreground
                                 (black at rest, white on hover) - a hardcoded local value always wins
                                 over inherited property values in WPF, so recoloring the Button itself
                                 had no visible effect on these children. Removed the hardcoded
                                 Foreground on both so they inherit from the Button's own Foreground
                                 and actually track its rest/hover state. -->
                            <Button x:Name="BtnCancel" Grid.Column="1" Style="{StaticResource ProgressButton}" Width="80" Click="BtnCancel_Click" ToolTip="Cancel operation">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="CircleXmarkSolid" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Cancel" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Overlay -->
                <local:AppOverlay x:Name="AppOverlayControl" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
            </Grid>
    </Border>
</utils:DpiAwareWindow>
