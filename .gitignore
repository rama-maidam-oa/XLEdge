# Build output
bin/
obj/

# Visual Studio / IDE
.vs/
*.user
*.suo
*.cache

# NuGet package cache (restored via NuGet, not tracked)
packages/

# Misc build/debug artifacts (not applicable to checked-in dependency DLLs
# under Interops/ or Loader/, which are intentionally tracked)
*.log
*.tlb
*.reg
*.nupkg

# graphify knowledge-graph output (generated, regenerate with /graphify)
graphify-out/

# Installer build output (built .msi + intermediate files, not source)
*.msi
XLEdge/setupfiles/Debug/
XLEdge/setupfiles/Release/

# local Claude Code settings (machine-specific, not shared)
.claude/
