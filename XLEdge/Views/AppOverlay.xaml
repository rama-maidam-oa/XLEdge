<UserControl x:Class="XLEdge.Views.AppOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XLEdge.Views"
             xmlns:conv="clr-namespace:XLEdge.Converters"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Visibility="Collapsed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLEdge;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters (control-specific) -->
            <conv:WidthPercentageConverter x:Key="PercentConverter"/>

            <!-- Toast Animation (control-specific) -->
            <Storyboard x:Key="ToastSlideIn">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="50" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Key="ToastSlideOut">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="0" To="50" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.3"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootOverlay">
        <!-- Toast Overlay -->
        <!-- Bug fix, corrected per direct feedback: the toast should stay docked at the TOP (not
             centered mid-screen like Busy/Confirm - that was an over-correction) and just needs to be
             fully visible/uncropped there. Keeps the ToastOverlay dim scrim (still hides WebView2
             underneath via _toastHidesWebView2), but the card itself is back to a Stretch/Top banner
             instead of a centered popup. "Show completely": the ScrollViewer + generous MaxHeight (see
             UpdateToastMaxHeight in code-behind) let a long message wrap and scroll internally rather
             than being clipped, and Padding/Margin below keep it clear of the pane's edges.
             Bug fix (screenshot-confirmed, "taskpane appoverlay issue"): this Grid used to be
             VerticalAlignment="Stretch", covering the ENTIRE remaining taskpane below the toast banner
             with its #80000000 dim Background - and since ApplyBlurToSiblings() also hides the
             WebView2 control underneath for the whole time a toast is shown (the only way around
             WebView2's "airspace" limitation - see the field comment on _hiddenWebViewElements), there
             was nothing but the plain panel background (#F8F9FA, near-white) behind that scrim, so the
             whole pane below a small one-line toast rendered as one giant, ugly, flat gray rectangle -
             looking exactly like the taskpane had frozen/broken, even though only the toast banner
             itself needed to be visible/interactive. Changed VerticalAlignment to "Top" so this dim
             scrim (and its input-blocking) now only covers the Toast's own rendered height, matching
             its sibling Toast Border's alignment - the area below the toast (where WebView2 is still
             hidden while the toast is up) now just shows the plain light panel background instead of
             an oversized dark overlay. -->
        <Grid x:Name="ToastOverlay" Visibility="Collapsed" Background="Transparent" IsHitTestVisible="True" Focusable="True" HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="10000">
            <!-- MaxHeight is set from code-behind (AppOverlay.UpdateToastMaxHeight), not bound here -
                 see that method for why: this whole control is Collapsed between toasts (DismissToast),
                 and a just-uncollapsed element's own ActualHeight/RootOverlay's is stale/zero until the
                 next full layout pass. -->
            <!-- Toast Message Container -->
            <Border x:Name="Toast" 
        Visibility="Collapsed" 
        Background="#1E1E1E" 
        CornerRadius="0" 
        BorderBrush="#333333" 
        BorderThickness="0,0,0,1"
        MinHeight="80"
        MaxHeight="400"
        HorizontalAlignment="Stretch" 
        VerticalAlignment="Top"
        Width="Auto"
        Padding="20,15,20,15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <iconPacks:PackIconFontAwesome x:Name="ToastIcon" 
                                       Grid.Column="0" 
                                       Width="24" 
                                       Height="24" 
                                       Margin="0,0,15,0"
                                       VerticalAlignment="Center"/>

                    <!-- Message Text -->
                    <TextBlock x:Name="ToastMessage" 
                   Grid.Column="1" 
                   TextWrapping="Wrap" 
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="White"
                   MinHeight="20"/>

                    <!-- Close Button -->
                    <Button x:Name="BtnCloseToast" 
        Grid.Column="2" 
        Content="✕"
        FontSize="18"
        BorderThickness="0"
        Cursor="Hand"
        Margin="15,0,0,0"
        VerticalAlignment="Center"
        Width="30"
        Height="30"
        Click="BtnCloseToast_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="Red"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="DarkRed"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!-- Busy Overlay -->
        <Grid x:Name="BusyOverlay" Background="#80000000" Visibility="Collapsed" Opacity="0" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10000">
            <Border Background="White" Padding="20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="SpinnerSolid" Spin="True" Width="48" Height="48" Foreground="SteelBlue" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="BusyMessage" Text="Please wait..." FontFamily="Segoe UI" Margin="0,0,0,12" FontSize="15" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BusyElapsed" Text="" FontFamily="Segoe UI" Margin="0,0,0,6" FontSize="13" Foreground="Gray" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <Button x:Name="BtnCancelBusy" Style="{StaticResource CancelButtonStyle}"
                            Visibility="Collapsed" FontFamily="Segoe UI" Margin="0,10,0,0" Click="BtnHideBusy_Click">
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Confirmation Overlay -->
        <Grid x:Name="ConfirmOverlay" Background="#80000000" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10002">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="ConfirmPopup" Background="White" CornerRadius="12" Padding="20"
                        MinWidth="280"
                        MaxWidth="{Binding ActualWidth, ElementName=RootOverlay, Converter={StaticResource PercentConverter}, ConverterParameter=0.7}"
                        MaxHeight="{Binding ActualHeight, ElementName=RootOverlay, Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="ConfirmText" Text="Are you sure?" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnYes" Style="{StaticResource DynamicContentButton}" Grid.Column="0" Margin="5" Height="32" MinWidth="80" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="CircleCheckSolid" Width="16" Height="16" Foreground="Green" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yes" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNo" Style="{StaticResource DynamicContentButton}" Grid.Column="1" Margin="5" Height="32" MinWidth="80" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="CircleXmarkSolid" Width="16" Height="16" Foreground="Red" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="No" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCancel" Style="{StaticResource DynamicContentButton}" Grid.Column="2" Margin="5" Height="32" MinWidth="80" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="BanSolid" Width="16" Height="16" Foreground="DarkOrange" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cancel" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>